# 复制为本地 .env 或在启动后端前设置环境变量。不要提交真实 Key。
DB_URL=jdbc:mysql://127.0.0.1:3306/mindtrace?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 以 https://api.deepseek.com/models 返回的可用模型为准
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
# 推理模型会把思维链 token 计入 max_tokens，JSON 模式预算不足会导致结案报告 JSON 被截断
DEEPSEEK_CHAT_MAX_TOKENS=1200
DEEPSEEK_JSON_MAX_TOKENS=8000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRATION_HOURS=72
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
